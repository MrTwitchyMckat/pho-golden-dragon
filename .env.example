# Nuxt (public — embedded at build time for this static app)
NUXT_PUBLIC_SANITY_PROJECT_ID=03e15w02
NUXT_PUBLIC_SANITY_DATASET=production

# Studio + seed script (optional overrides)
SANITY_STUDIO_PROJECT_ID=03e15w02
SANITY_STUDIO_DATASET=production

# Create at https://www.sanity.io/manage → Project → API → Tokens (Editor)
# Used only for: npm run sanity:seed (from repo root) or cd studio && npm run seed
SANITY_API_WRITE_TOKEN=
